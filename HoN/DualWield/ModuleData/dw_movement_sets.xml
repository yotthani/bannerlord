                left_back="act_walk_left_back_1h_with_h_shld_left_stance"
                left_to_right="act_walk_left_to_right_1h_with_h_shld_left_stance"
                right_to_left="act_walk_right_to_left_1h_with_h_shld_left_stance"
                rotate="act_turn_1h_with_shield_left_stance"
                forward_adder="act_walk_forward_adder"
                backward_adder="act_walk_backward_adder"
                right_adder="act_walk_right_adder"
                right_back_adder="act_walk_right_back_adder"
                left_adder="act_walk_left_adder"
