<?xml version="1.0" encoding="utf-8"?>
<!--
  DualWield Mod - Movement Sets for dual wield stance.
  Reuses vanilla hand_shield (h_shld) action types directly.
  Only the movement_set IDs are custom; all actions are vanilla.
-->
<movement_sets>

  <!-- ===== WALK ===== -->
  <movement_set id="walk_1h_with_dw"
                idle="act_walk_idle_1h_with_h_shld"
                forward="act_walk_forward_1h_with_h_shld"
                backward="act_walk_backward_1h_with_h_shld"
                right="act_walk_right_1h_with_h_shld"
                right_back="act_walk_right_back_1h_with_h_shld"
                left="act_walk_left_1h_with_h_shld"
                left_back="act_walk_left_back_1h_with_h_shld"
                left_to_right="act_walk_left_to_right_1h_with_h_shld"
                right_to_left="act_walk_right_to_left_1h_with_h_shld"
                rotate="act_turn_1h_with_shield"
                forward_adder="act_walk_forward_adder"
                backward_adder="act_walk_backward_adder"
                right_adder="act_walk_right_adder"
                right_back_adder="act_walk_right_back_adder"
                left_adder="act_walk_left_adder"
                left_back_adder="act_walk_left_back_adder"
                left_to_right_adder="act_walk_left_to_right_adder"
                right_to_left_adder="act_walk_right_to_left_adder" />

  <movement_set id="walk_1h_with_dw_left_stance"
                idle="act_walk_idle_1h_with_h_shld_left_stance"
