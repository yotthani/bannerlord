<?xml version="1.0" encoding="utf-8"?>
<!--
  DualWield Mod - Item Usage Sets (v9.0)

  KEY MECHANISM: require_left_hand_usage_root_set="dw_offhand"
  This tells the engine: "when the offhand holds a dw_offhand weapon,
  use these usages and movement sets." The engine handles left-hand
  attacks automatically via the left_stance system.

  Unlike ROT (76 custom action types), we reuse vanilla 1h actions
  directly. The engine plays the same animations but knows the offhand
  is active via the condition.

  Three usage sets:
  1. dw_offhand         - offhand weapon (shield-like behavior)
  2. dw_mainhand_swing  - mainhand with slash attacks
  3. dw_mainhand_swing_thrust - mainhand with slash + thrust
-->
<item_usage_sets>

  <!-- ============================================================ -->
  <!-- OFF-HAND: Shield-like behavior for the offhand weapon.       -->
  <!-- base_set="hand_shield" gives it shield movement/guard layer. -->
  <!-- Movement set = our custom 1h_with_dw (dual wield stance).   -->
  <!-- ============================================================ -->
  <item_usage_set id="dw_offhand" base_set="hand_shield">
    <movement_sets>
      <movement_set id="1h_with_dw"/>
    </movement_sets>
  </item_usage_set>

  <!-- ============================================================ -->
  <!-- MAINHAND: 1h sword attacks with dual wield support.          -->
  <!--                                                              -->
  <!-- Dual-wield usages (require_left_hand_usage_root_set) are     -->
  <!-- selected when offhand has dw_offhand equipped.               -->
  <!-- Solo usages (require_free_left_hand="False") are fallback.   -->
  <!-- ============================================================ -->
  <item_usage_set id="dw_mainhand_swing"
                  switch_to_alternate_action="act_switch_back_alternate_knife"
                  switch_to_alternate_action_left_stance="act_switch_back_alternate_knife_left_stance"
                  equip_sound="event:/mission/combat/equip/sword_equip"
                  unequip_sound="event:/mission/combat/equip/sword_unequip">
    <idles>
      <!-- Dual wield idle (with offhand) -->
      <idle action="act_idle_1h_with_shield_1"
            require_left_hand_usage_root_set="dw_offhand"/>
      <idle action="act_idle_1h_with_shield_1_left_stance"
            is_left_stance="True"
            require_left_hand_usage_root_set="dw_offhand"/>
      <!-- Solo idle (no offhand) -->
      <idle action="act_idle_1h_without_shield_1"
            require_free_left_hand="True"/>
      <idle action="act_idle_1h_without_shield_1_left_stance"
            is_left_stance="True"
            require_free_left_hand="True"/>
      <!-- Generic fallback -->
      <idle action="act_idle_1h_with_shield_1"
            require_free_left_hand="False"/>
      <idle action="act_idle_1h_with_shield_1_left_stance"
            is_left_stance="True"
            require_free_left_hand="False"/>
    </idles>

    <movement_sets>
      <!-- Dual wield movement (when offhand has dw_offhand) -->
      <movement_set id="1h_with_dw"
                    require_left_hand_usage_root_set="dw_offhand"/>
      <!-- Shield fallback -->
      <movement_set id="1h_with_hand_shield"
                    require_left_hand_usage_root_set="shield"/>
      <!-- Solo fallback -->
      <movement_set id="1h_with_hand_shield"/>
    </movement_sets>

    <usages>
      <!-- ======= DUAL WIELD ATTACK USAGES ======= -->
      <!-- Active when offhand has dw_offhand weapon.
           Uses vanilla 1h actions — the engine knows the offhand
           is active and handles both hands via left_stance. -->

      <!-- attack_up (overswing) — dual wield -->
      <usage style="attack_up"
             ready_action="act_ready_overswing_1h"
             ready_from_up_action="act_ready_from_up_overswing_1h"
             ready_from_left_action="act_ready_from_left_overswing_1h"
             ready_from_right_action="act_ready_from_right_overswing_1h"
             quick_release_action="act_quick_release_overswing_1h"
             release_action="act_release_overswing_1h"
             quick_blocked_action="act_quick_blocked_overswing_1h"
             blocked_action="act_blocked_overswing_1h"
             is_mounted="False"
             require_left_hand_usage_root_set="dw_offhand"
             strike_type="swing"/>

      <!-- attack_right (slashright) — dual wield -->
      <usage style="attack_right"
             ready_action="act_ready_slashright_1h"
             ready_from_up_action="act_ready_from_up_slashright_1h"
             ready_from_right_action="act_ready_from_right_slashright_1h"
             quick_release_action="act_quick_release_slashright_1h"
             release_action="act_release_slashright_1h"
             quick_blocked_action="act_quick_blocked_slashright_1h"
             blocked_action="act_blocked_slashright_1h"
             is_mounted="False"
             require_left_hand_usage_root_set="dw_offhand"
             strike_type="swing"/>

      <!-- attack_left (slashleft) — dual wield -->
      <usage style="attack_left"
             ready_action="act_ready_slashleft_1h"
             ready_from_up_action="act_ready_from_up_slashleft_1h"
             ready_from_left_action="act_ready_from_left_slashleft_1h"
             quick_release_action="act_quick_release_slashleft_1h"
             release_action="act_release_slashleft_1h"
             quick_blocked_action="act_quick_blocked_slashleft_1h"
             blocked_action="act_blocked_slashleft_1h"
             is_mounted="False"
             require_left_hand_usage_root_set="dw_offhand"
             strike_type="swing"/>

      <!-- ======= DUAL WIELD LEFT_STANCE USAGES ======= -->
      <!-- Left_stance versions — engine uses these for offhand attacks -->

      <!-- attack_up left_stance — dual wield -->
      <usage style="attack_up"
             is_left_stance="True"
             ready_action="act_ready_overswing_1h_left_stance"
             ready_from_up_action="act_ready_from_up_overswing_1h_left_stance"
             ready_from_left_action="act_ready_from_left_overswing_1h_left_stance"
             ready_from_right_action="act_ready_from_right_overswing_1h_left_stance"
             quick_release_action="act_quick_release_overswing_1h_left_stance"
             release_action="act_release_overswing_1h_left_stance"
             quick_blocked_action="act_quick_blocked_overswing_1h_left_stance"
             blocked_action="act_blocked_overswing_1h_left_stance"
             is_mounted="False"
             require_left_hand_usage_root_set="dw_offhand"
             strike_type="swing"/>

      <!-- attack_right left_stance — dual wield -->
      <usage style="attack_right"
             is_left_stance="True"
             ready_action="act_ready_slashright_1h_left_stance"
             ready_from_up_action="act_ready_from_up_slashright_1h_left_stance"
             ready_from_right_action="act_ready_from_right_slashright_1h_left_stance"
             quick_release_action="act_quick_release_slashright_1h_left_stance"
             release_action="act_release_slashright_1h_left_stance"
             quick_blocked_action="act_quick_blocked_slashright_1h_left_stance"
             blocked_action="act_blocked_slashright_1h_left_stance"
             is_mounted="False"
             require_left_hand_usage_root_set="dw_offhand"
             strike_type="swing"/>

      <!-- attack_left left_stance — dual wield -->
      <usage style="attack_left"
             is_left_stance="True"
             ready_action="act_ready_slashleft_1h_left_stance"
             ready_from_up_action="act_ready_from_up_slashleft_1h_left_stance"
             ready_from_left_action="act_ready_from_left_slashleft_1h_left_stance"
             quick_release_action="act_quick_release_slashleft_1h_left_stance"
             release_action="act_release_slashleft_1h_left_stance"
             quick_blocked_action="act_quick_blocked_slashleft_1h_left_stance"
             blocked_action="act_blocked_slashleft_1h_left_stance"
             is_mounted="False"
             require_left_hand_usage_root_set="dw_offhand"
             strike_type="swing"/>

      <!-- ======= SOLO USAGES (no offhand) ======= -->
      <!-- Fallback when wielding mainhand without offhand -->

      <usage style="attack_up"
             ready_action="act_ready_overswing_1h"
             ready_from_up_action="act_ready_from_up_overswing_1h"
             ready_from_left_action="act_ready_from_left_overswing_1h"
             ready_from_right_action="act_ready_from_right_overswing_1h"
             quick_release_action="act_quick_release_overswing_1h"
             release_action="act_release_overswing_1h"
             quick_blocked_action="act_quick_blocked_overswing_1h"
             blocked_action="act_blocked_overswing_1h"
             is_mounted="False"
             require_free_left_hand="False"
             strike_type="swing"/>

      <usage style="attack_right"
             ready_action="act_ready_slashright_1h"
             ready_from_up_action="act_ready_from_up_slashright_1h"
             ready_from_right_action="act_ready_from_right_slashright_1h"
             quick_release_action="act_quick_release_slashright_1h"
             release_action="act_release_slashright_1h"
             quick_blocked_action="act_quick_blocked_slashright_1h"
             blocked_action="act_blocked_slashright_1h"
             is_mounted="False"
             require_free_left_hand="False"
             strike_type="swing"/>

      <usage style="attack_left"
             ready_action="act_ready_slashleft_1h"
             ready_from_up_action="act_ready_from_up_slashleft_1h"
             ready_from_left_action="act_ready_from_left_slashleft_1h"
             quick_release_action="act_quick_release_slashleft_1h"
             release_action="act_release_slashleft_1h"
             quick_blocked_action="act_quick_blocked_slashleft_1h"
             blocked_action="act_blocked_slashleft_1h"
             is_mounted="False"
             require_free_left_hand="False"
             strike_type="swing"/>

      <!-- Solo left_stance (for natural stance switching) -->
      <usage style="attack_up"
             is_left_stance="True"
             ready_action="act_ready_overswing_1h_left_stance"
             ready_from_up_action="act_ready_from_up_overswing_1h_left_stance"
             ready_from_left_action="act_ready_from_left_overswing_1h_left_stance"
             ready_from_right_action="act_ready_from_right_overswing_1h_left_stance"
             quick_release_action="act_quick_release_overswing_1h_left_stance"
             release_action="act_release_overswing_1h_left_stance"
             quick_blocked_action="act_quick_blocked_overswing_1h_left_stance"
             blocked_action="act_blocked_overswing_1h_left_stance"
             is_mounted="False"
             require_free_left_hand="False"
             strike_type="swing"/>

      <usage style="attack_right"
             is_left_stance="True"
             ready_action="act_ready_slashright_1h_left_stance"
             ready_from_up_action="act_ready_from_up_slashright_1h_left_stance"
             ready_from_right_action="act_ready_from_right_slashright_1h_left_stance"
             quick_release_action="act_quick_release_slashright_1h_left_stance"
             release_action="act_release_slashright_1h_left_stance"
             quick_blocked_action="act_quick_blocked_slashright_1h_left_stance"
             blocked_action="act_blocked_slashright_1h_left_stance"
             is_mounted="False"
             require_free_left_hand="False"
             strike_type="swing"/>

      <usage style="attack_left"
             is_left_stance="True"
             ready_action="act_ready_slashleft_1h_left_stance"
             ready_from_up_action="act_ready_from_up_slashleft_1h_left_stance"
             ready_from_left_action="act_ready_from_left_slashleft_1h_left_stance"
             quick_release_action="act_quick_release_slashleft_1h_left_stance"
             release_action="act_release_slashleft_1h_left_stance"
             quick_blocked_action="act_quick_blocked_slashleft_1h_left_stance"
             blocked_action="act_blocked_slashleft_1h_left_stance"
             is_mounted="False"
             require_free_left_hand="False"
             strike_type="swing"/>

    </usages>

    <guards>
      <!-- Dual wield guards -->
      <guard style="up"
             action="act_guard_up_1h"
             require_left_hand_usage_root_set="dw_offhand"
             hand_position="0,0.1,0.2"
             hand_rotation="0,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="up"
             is_left_stance="True"
             action="act_guard_up_1h_left_stance"
             require_left_hand_usage_root_set="dw_offhand"
             hand_position="0,0.1,0.2"
             hand_rotation="0,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="down"
             action="act_guard_bottom_1h"
             require_left_hand_usage_root_set="dw_offhand"
             hand_position="0,0.1,-0.3"
             hand_rotation="0,-72"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="down"
             is_left_stance="True"
             action="act_guard_bottom_1h_left_stance"
             require_left_hand_usage_root_set="dw_offhand"
             hand_position="0,0.1,-0.3"
             hand_rotation="0,-72"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="left"
             action="act_guard_left_1h"
             require_left_hand_usage_root_set="dw_offhand"
             hand_position="-0.2,0.1,-0.2"
             hand_rotation="-36,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="left"
             is_left_stance="True"
             action="act_guard_left_1h_left_stance"
             require_left_hand_usage_root_set="dw_offhand"
             hand_position="-0.2,0.1,-0.2"
             hand_rotation="-36,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="right"
             action="act_guard_right_1h"
             require_left_hand_usage_root_set="dw_offhand"
             hand_position="0.2,0.1,-0.2"
             hand_rotation="36,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="right"
             is_left_stance="True"
             action="act_guard_right_1h_left_stance"
             require_left_hand_usage_root_set="dw_offhand"
             hand_position="0.2,0.1,-0.2"
             hand_rotation="36,0"
             arm_rotation="0,0"
             arm_length="0"/>

      <!-- Solo guards (fallback) -->
      <guard style="up"
             action="act_guard_up_1h"
             hand_position="0,0.1,0.2"
             hand_rotation="0,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="up"
             is_left_stance="True"
             action="act_guard_up_1h_left_stance"
             hand_position="0,0.1,0.2"
             hand_rotation="0,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="down"
             action="act_guard_bottom_1h"
             hand_position="0,0.1,-0.3"
             hand_rotation="0,-72"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="down"
             is_left_stance="True"
             action="act_guard_bottom_1h_left_stance"
             hand_position="0,0.1,-0.3"
             hand_rotation="0,-72"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="left"
             action="act_guard_left_1h"
             hand_position="-0.2,0.1,-0.2"
             hand_rotation="-36,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="left"
             is_left_stance="True"
             action="act_guard_left_1h_left_stance"
             hand_position="-0.2,0.1,-0.2"
             hand_rotation="-36,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="right"
             action="act_guard_right_1h"
             hand_position="0.2,0.1,-0.2"
             hand_rotation="36,0"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="right"
             is_left_stance="True"
             action="act_guard_right_1h_left_stance"
             hand_position="0.2,0.1,-0.2"
             hand_rotation="36,0"
             arm_rotation="0,0"
             arm_length="0"/>

      <!-- None guard -->
      <guard style="none"
             hand_position="0,0,-0.5"
             hand_rotation="0,-90"
             arm_rotation="0,0"
             arm_length="0"/>
      <guard style="none"
             is_left_stance="True"
             hand_position="0,0,-0.5"
             hand_rotation="0,-90"
             arm_rotation="0,0"
             arm_length="0"/>
    </guards>

    <kick_usages>
      <kick_usage release_action="act_1h_bash"
                  hit_action="act_hit_1h_bash"
                  is_left_stance="False"
                  left_hand_empty="True"/>
      <kick_usage release_action="act_1h_bash_left_stance"
                  hit_action="act_hit_1h_bash_left_stance"
                  left_hand_empty="True"
                  is_left_stance="True"/>
    </kick_usages>
  </item_usage_set>

  <!-- Variant with thrust (extends swing) -->
  <item_usage_set id="dw_mainhand_swing_thrust"
                  base_set="dw_mainhand_swing">
    <usages>
      <!-- Thrust — dual wield -->
      <usage style="attack_down"
             ready_action="act_ready_thrust_1h"
             quick_release_action="act_quick_release_thrust_1h"
             release_action="act_release_thrust_1h"
             quick_blocked_action="act_quick_blocked_thrust_1h"
             blocked_action="act_blocked_thrust_1h"
             quick_stuck_action="act_stuck_quick_thrust_1h"
             stuck_action="act_stuck_thrust_1h"
             is_mounted="False"
             require_left_hand_usage_root_set="dw_offhand"
             strike_type="thrust"/>

      <!-- Thrust left_stance — dual wield -->
      <usage style="attack_down"
             is_left_stance="True"
             ready_action="act_ready_thrust_1h_left_stance"
             quick_release_action="act_quick_release_thrust_1h_left_stance"
             release_action="act_release_thrust_1h_left_stance"
             quick_blocked_action="act_quick_blocked_thrust_1h_left_stance"
             blocked_action="act_blocked_thrust_1h_left_stance"
             quick_stuck_action="act_stuck_quick_thrust_1h_left_stance"
             stuck_action="act_stuck_thrust_1h_left_stance"
             is_mounted="False"
             require_left_hand_usage_root_set="dw_offhand"
             strike_type="thrust"/>

      <!-- Thrust — solo fallback -->
      <usage style="attack_down"
             ready_action="act_ready_thrust_1h"
             quick_release_action="act_quick_release_thrust_1h"
             release_action="act_release_thrust_1h"
             quick_blocked_action="act_quick_blocked_thrust_1h"
             blocked_action="act_blocked_thrust_1h"
             quick_stuck_action="act_stuck_quick_thrust_1h"
             stuck_action="act_stuck_thrust_1h"
             is_mounted="False"
             require_free_left_hand="False"
             strike_type="thrust"/>

      <!-- Thrust left_stance — solo fallback -->
      <usage style="attack_down"
             is_left_stance="True"
             ready_action="act_ready_thrust_1h_left_stance"
             quick_release_action="act_quick_release_thrust_1h_left_stance"
             release_action="act_release_thrust_1h_left_stance"
             quick_blocked_action="act_quick_blocked_thrust_1h_left_stance"
             blocked_action="act_blocked_thrust_1h_left_stance"
             quick_stuck_action="act_stuck_quick_thrust_1h_left_stance"
             stuck_action="act_stuck_thrust_1h_left_stance"
             is_mounted="False"
             require_free_left_hand="False"
             strike_type="thrust"/>
    </usages>
  </item_usage_set>

</item_usage_sets>
