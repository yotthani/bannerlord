<?xml version="1.0" encoding="utf-8"?>
<!--
═══════════════════════════════════════════════════════════════════════════════════════════════
THEMED BRUSHES — MAPPED TO REAL VANILLA BANNERLORD BRUSH NAMES

Uses ColorRef attributes to reference colors from the theme's ColorScheme.
At runtime, ColorRef values are resolved to actual colors based on the active theme.

Available ColorRef values:
  Primary, Secondary, Tertiary
  Text, TextMuted, TextHighlight, TextTitle, TextOnPrimary, TextDisabled
  Background, BackgroundDark, BackgroundLight, BackgroundAccent, BackgroundHover, BackgroundSelected
  Border, BorderMuted, BorderHighlight, BorderSecondary
  ButtonBackground, ButtonHover, ButtonPressed, ButtonDisabled, ButtonBorder
  Success, Warning, Error, Info
  Gold, Experience, Health, Morale, Shadow, Glow

Note: ColorRef takes priority over Color if both are specified.
Color format: #RRGGBB or #RRGGBBAA (6 or 8 hex chars)
═══════════════════════════════════════════════════════════════════════════════════════════════
-->
<Brushes>

  <!-- ══════════════════════════════════════════════════════════════════════════════════════ -->
  <!-- BASE / GLOBAL BRUSHES (Base.xml) — affect nearly EVERY screen                      -->
  <!-- ══════════════════════════════════════════════════════════════════════════════════════ -->

  <!-- THE default text brush used almost everywhere in the game -->
  <Brush Name="DefaultBrush">
    <Styles>
      <Style Name="Default" FontColorRef="Text" />
    </Styles>
  </Brush>

  <!-- Rich text with hyperlinks (encyclopedia, tooltips, descriptions) -->
  <Brush Name="Info.Text">
    <Styles>
      <Style Name="Default" FontColorRef="Text" />
    </Styles>
  </Brush>

  <Brush Name="DefaultRichText">
    <Styles>
      <Style Name="Default" FontColorRef="Text" />
    </Styles>
  </Brush>

  <Brush Name="DefaultRichText2">
    <Styles>
      <Style Name="Default" FontColorRef="TextMuted" />
    </Styles>
  </Brush>

